model BloodRequest {
  id            String        @id @default(uuid())
  creatorId     String
  requesterType RequesterType @default(INDIVIDUAL)
  patientName   String
  bloodGroup    BloodGroup
  unitsNeeded   Int
  hospitalName  String?
  city          String
  area          String?
  urgency       String        @default("normal")
  status        RequestStatus @default(PENDING)
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  reason        String
  creator       User          @relation("RequestCreator", fields: [creatorId], references: [id])
  verifier      User?         @relation("RequestVerifier", fields: [verifiedById], references: [id])
  campaign      Campaign?
  donations     Donation[]
  matches       DonorMatch[]

  @@index([status])
  @@index([bloodGroup, city])
}

model DonorMatch {
  id          String       @id @default(uuid())
  requestId   String
  donorId     String
  status      MatchStatus  @default(PENDING)
  notifiedAt  DateTime     @default(now())
  respondedAt DateTime?
  createdAt   DateTime     @default(now())
  donor       User         @relation("MatchedDonor", fields: [donorId], references: [id])
  request     BloodRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, donorId])
  @@index([status])
}

model Donation {
  id          String         @id @default(uuid())
  requestId   String
  donorId     String
  status      DonationStatus @default(SCHEDULED)
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  deletedAt   DateTime?
  donor       User           @relation("DonationDonor", fields: [donorId], references: [id])
  request     BloodRequest   @relation(fields: [requestId], references: [id])

  @@index([status])
}

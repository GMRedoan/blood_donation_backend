model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  role          Role
  name          String
  phone         String?
  city          String?
  area          String?
  isEmailVerified Boolean   @default(false)
  isVerifiedOrg Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  donorProfile  DonorProfile?
  refreshTokens RefreshToken[]

  volunteerAssignment VolunteerAssignment? @relation("VolunteerUser")
  volunteerGrantsMade VolunteerAssignment[] @relation("VolunteerGrantedBy")

  bloodRequestsCreated BloodRequest[] @relation("RequestCreator")
  bloodRequestsVerified BloodRequest[] @relation("RequestVerifier")
  donorMatches          DonorMatch[]  @relation("MatchedDonor")
  donations             Donation[]    @relation("DonationDonor")
  campaignsCreated      Campaign[]    @relation("CampaignCreator")
  contributions         Contribution[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([role])
  @@index([city, area])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VolunteerAssignment {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation("VolunteerUser", fields: [userId], references: [id])
  assignedById String
  assignedBy   User      @relation("VolunteerGrantedBy", fields: [assignedById], references: [id])
  permissions  Json       
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?

  @@index([isActive])
}

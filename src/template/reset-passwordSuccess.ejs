<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blood Bridge - Password Reset Successful</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f8fafc;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f8fafc; padding: 40px 15px;">

        <tr>
            <td align="center">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="
                        max-width: 520px;
                        background-color: #ffffff;
                        border-radius: 18px;
                        overflow: hidden;
                        box-shadow: 0 8px 30px rgba(185, 28, 28, 0.08);
                    ">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="
                            padding: 40px 25px;
                            background-color: #b91c1c;
                            background-image: linear-gradient(135deg, #991b1b, #dc2626);
                        ">

                            <!-- Success Icon -->
                            <div style="
                                width: 72px;
                                height: 72px;
                                line-height: 72px;
                                background-color: rgba(255,255,255,0.18);
                                border-radius: 50%;
                                font-size: 36px;
                                color: #ffffff;
                                font-weight: bold;
                            ">
                                ✓
                            </div>

                            <h1 style="
                                margin: 18px 0 5px;
                                color: #ffffff;
                                font-size: 26px;
                                font-weight: 800;
                            ">
                                Password Reset Successful
                            </h1>

                            <p style="
                                margin: 0;
                                color: #fee2e2;
                                font-size: 14px;
                            ">
                                Your Blood Bridge account is secure
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 38px 32px;">

                            <h2 style="
                                margin: 0 0 12px;
                                font-size: 23px;
                                color: #111827;
                            ">
                                You're all set! 🎉
                            </h2>

                            <p style="
                                margin: 0 0 25px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #64748b;
                            ">
                                Your password has been successfully changed.
                                You can now use your new password to sign in
                                to your Blood Bridge account.
                            </p>

                            <!-- Success Message -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="
                                        background-color: #fef2f2;
                                        border: 1px solid #fecaca;
                                        border-radius: 14px;
                                        padding: 28px 20px;
                                    ">

                                        <!-- Check Icon -->
                                        <div style="
                                            width: 52px;
                                            height: 52px;
                                            line-height: 52px;
                                            margin: 0 auto 14px;
                                            background-color: #dc2626;
                                            color: #ffffff;
                                            border-radius: 50%;
                                            font-size: 26px;
                                            font-weight: bold;
                                        ">
                                            ✓
                                        </div>

                                        <p style="
                                            margin: 0;
                                            color: #991b1b;
                                            font-size: 16px;
                                            font-weight: 700;
                                        ">
                                            Password Updated Successfully
                                        </p>

                                        <p style="
                                            margin: 8px 0 0;
                                            color: #6b7280;
                                            font-size: 13px;
                                            line-height: 1.5;
                                        ">
                                            Your new password is now active.
                                            Your account is ready to use.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <!-- Security Notice -->
                            <table width="100%" cellpadding="0" cellspacing="0"
                                border="0" style="margin-top: 25px;">

                                <tr>
                                    <td style="
                                        background-color: #fff7ed;
                                        border-left: 4px solid #f97316;
                                        border-radius: 8px;
                                        padding: 15px;
                                        color: #9a3412;
                                        font-size: 13px;
                                        line-height: 1.7;
                                    ">
                                        🔒 <strong>Didn't make this change?</strong>
                                        <br>
                                        If you didn't reset your password,
                                        please contact our support team immediately
                                        to protect your account.
                                    </td>
                                </tr>
                            </table>

                            <!-- Additional Message -->
                            <p style="
                                margin: 25px 0 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #64748b;
                            ">
                                For your security, we recommend using a strong,
                                unique password that you don't use on other websites.
                            </p>

                            <p style="
                                margin: 25px 0 0;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #374151;
                            ">
                                Stay safe and keep making a difference with
                                <strong style="color: #dc2626;">
                                    Blood Bridge.
                                </strong>
                                ❤️
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="
                            padding: 25px 25px;
                            background-color: #fffafa;
                            border-top: 1px solid #fee2e2;
                        ">

                            <p style="
                                margin: 0 0 8px;
                                font-size: 13px;
                                color: #9ca3af;
                            ">
                                © 2026 Blood Bridge. All rights reserved.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #b0b7c3;
                            ">
                                This is an automated email.
                                Please do not reply to this message.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>
</html>
 
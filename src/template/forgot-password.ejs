<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blood Bridge - Password Reset</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f8fafc;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f8fafc; padding: 40px 15px;">

    <tr>
        <td align="center">

            <!-- Main Card -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="
                    max-width: 520px;
                    background-color: #ffffff;
                    border-radius: 18px;
                    overflow: hidden;
                    box-shadow: 0 8px 30px rgba(185, 28, 28, 0.08);
                ">

                <!-- Header -->
                <tr>
                    <td align="center" style="
                        padding: 35px 25px;
                        background-color: #b91c1c;
                        background-image: linear-gradient(135deg, #991b1b, #dc2626);
                    ">

                        <!-- Logo Icon -->
                        <div style="
                            width: 65px;
                            height: 65px;
                            line-height: 65px;
                            background-color: rgba(255,255,255,0.15);
                            border-radius: 50%;
                            font-size: 34px;
                            color: #ffffff;
                        ">
                            ♥
                        </div>

                        <h1 style="
                            margin: 15px 0 5px;
                            color: #ffffff;
                            font-size: 27px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                        ">
                            Blood Bridge
                        </h1>

                        <p style="
                            margin: 0;
                            color: #fee2e2;
                            font-size: 14px;
                        ">
                            Connecting Lives, Saving Lives
                        </p>

                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding: 38px 32px;">

                        <h2 style="
                            margin: 0 0 12px;
                            font-size: 23px;
                            color: #111827;
                        ">
                            Reset Your Password
                        </h2>

                        <p style="
                            margin: 0 0 25px;
                            font-size: 15px;
                            line-height: 1.7;
                            color: #64748b;
                        ">
                            Hello,
                            <br><br>
                            We received a request to reset your Blood Bridge
                            account password. To continue, please use the
                            verification code below.
                        </p>

                        <!-- OTP Box -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td align="center" style="
                                    background-color: #fef2f2;
                                    border: 2px dashed #ef4444;
                                    border-radius: 14px;
                                    padding: 25px 15px;
                                ">

                                    <p style="
                                        margin: 0 0 12px;
                                        color: #991b1b;
                                        font-size: 12px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        letter-spacing: 2px;
                                    ">
                                        Your Verification Code
                                    </p>

                                    <div style="
                                        font-size: 38px;
                                        font-weight: 800;
                                        letter-spacing: 10px;
                                        color: #dc2626;
                                        padding-left: 10px;
                                    ">
                                        <%= otp %>
                                    </div>

                                </td>
                            </tr>
                        </table>

                        <!-- Expiry Notice -->
                        <table width="100%" cellpadding="0" cellspacing="0"
                            border="0" style="margin-top: 24px;">

                            <tr>
                                <td style="
                                    background-color: #fff7ed;
                                    border-left: 4px solid #f97316;
                                    border-radius: 8px;
                                    padding: 15px;
                                    color: #9a3412;
                                    font-size: 13px;
                                    line-height: 1.6;
                                ">
                                    ⏱️ <strong>This code expires in 2 minutes.</strong>
                                    <br>
                                    Please verify your account before the code expires.
                                </td>
                            </tr>
                        </table>

                        <!-- Security Notice -->
                        <p style="
                            margin: 25px 0 0;
                            font-size: 14px;
                            line-height: 1.7;
                            color: #64748b;
                        ">
                            If you didn't request a password reset, you can
                            safely ignore this email. Your account will remain
                            secure. Never share your verification code with anyone.
                        </p>

                        <p style="
                            margin: 25px 0 0;
                            font-size: 14px;
                            color: #374151;
                            line-height: 1.6;
                        ">
                            Stay safe, and thank you for being part of
                            <strong style="color: #dc2626;">Blood Bridge.</strong>
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td align="center" style="
                        padding: 25px 25px;
                        background-color: #fffafa;
                        border-top: 1px solid #fee2e2;
                    ">

                        <p style="
                            margin: 0 0 8px;
                            font-size: 13px;
                            color: #9ca3af;
                        ">
                            © 2026 Blood Bridge. All rights reserved.
                        </p>

                        <p style="
                            margin: 0;
                            font-size: 12px;
                            color: #b0b7c3;
                        ">
                            This is an automated email.
                            Please do not reply to this message.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>
